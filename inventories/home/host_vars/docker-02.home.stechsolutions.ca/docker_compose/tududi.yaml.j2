---
name: tududi

services:
  postgres_tududi_db:
    image: postgres:18.6
    user: 1000:1000
    networks:
      - tududi_postgres
    container_name: postgres_tududi_db
    environment:
      - POSTGRES_DB={{ tududi_db_name }}
      - POSTGRES_USER={{ tududi_db_user }}
      - POSTGRES_PASSWORD={{ secret_tududi_db_password }}
    volumes:
      - /home/{{ default_user }}/docker_mounts/files/tududi/postgres:/var/lib/postgresql
      - /etc/passwd:/etc/passwd:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ tududi_db_user }} -d {{ tududi_db_name }}"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 40s
      # check every 5s while starting, so tududi isn't held for a full interval
      start_interval: 5s
    restart: unless-stopped
    labels:
      - "wud.tag.include=^v?\\d+\\.\\d+(\\.\\d+)?$"
      - "wud.link.template=https://www.postgresql.org/docs/release/"

  tududi:
    image: chrisvel/tududi:2.1.0
    container_name: tududi
    networks:
      - traefik
      - tududi_postgres
    environment:
      - DATABASE_URL=postgres://{{ tududi_db_user }}:{{ secret_tududi_db_password }}@postgres_tududi_db:5432/{{ tududi_db_name }}
      - TUDUDI_USER_EMAIL={{ default_user_email }}
      - TUDUDI_USER_PASSWORD={{ secret_tududi_user_password }}
      - TUDUDI_SESSION_SECRET={{ secret_tududi_session_secret }}
      - TUDUDI_ALLOWED_ORIGINS=https://tududi.home.stechsolutions.ca
      - TUDUDI_TRUST_PROXY=true
    volumes:
      - /home/{{ default_user }}/docker_mounts/files/tududi/uploads:/app/uploads
      - /home/{{ default_user }}/docker_mounts/files/tududi/backups:/app/backups
    depends_on:
      postgres_tududi_db:
        condition: service_healthy
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.tududi.rule=Host(`tududi.home.stechsolutions.ca`)"
      - "traefik.docker.network=traefik"
      - "traefik.http.services.tududi.loadbalancer.server.port=3002"
      - "traefik.http.routers.tududi.entrypoints=websecure"
      - "traefik.http.routers.tududi.tls.certresolver=letsencrypt"
      - "homepage.group=Productivity"
      - "homepage.name=Tududi"
      - "homepage.description=Task and project management"
      - "homepage.icon=tududi.png"
      - "homepage.href=https://tududi.home.stechsolutions.ca"
      - "homepage.siteMonitor=https://tududi.home.stechsolutions.ca"
      - "wud.tag.include=^v?\\d+\\.\\d+\\.\\d+$"
      - "wud.link.template=https://github.com/chrisvel/tududi/releases"

networks:
  traefik:
    name: traefik
    external: true
  tududi_postgres:
    name: tududi_postgres
